# ---------------------------------------------------------------
# Newsletter Agent configuration. Copy to backend/.env and edit.
# NEVER commit your real .env file.
# ---------------------------------------------------------------

# Which model provider runs the agent by default: gemini | openai | ollama
LLM_PROVIDER=gemini

# Google Gemini (default, free tier available; get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (OPTIONAL, paid per token - a ChatGPT subscription does NOT include API credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Ollama (OPTIONAL, free local inference; needs `ollama serve` and a pulled model)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: provider to switch to ONLY if the default one runs out of quota (empty = never switch)
LLM_FALLBACK_PROVIDER=
# Optional: a different provider used as an independent critic (empty = primary model + deterministic checks)
CRITIC_PROVIDER=

# Research sources (free): google_news, gdelt, rss, hackernews. Optional: tavily (needs key)
SEARCH_PROVIDER=google_news,gdelt,rss,hackernews
# Comma separated publisher RSS feeds used by the "rss" source
# RSS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml
TAVILY_API_KEY=
NEWS_LANGUAGE=en
NEWS_COUNTRY=US
DEFAULT_LOOKBACK_DAYS=7
RESEARCH_CACHE_TTL_MINUTES=30
FETCH_ARTICLE_CONTENT=true
USE_LLM_RELEVANCE_FILTER=true

# Agent behaviour
MAX_REVISIONS=2
MAX_ARTICLES=7

# Server
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
